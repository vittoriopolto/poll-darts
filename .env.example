# Token dato da @BotFather
BOT_TOKEN=123456789:AA...
# Stringa di connessione Neon (Dashboard > Connect)
DATABASE_URL=postgresql://utente:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# ID Telegram degli admin, separati da virgola (scoprilo con /mio_id)
ADMIN_IDS=123456789
TIMEZONE=Europe/Rome
CLOSE_MINUTES_BEFORE=5
COVER_TITLE=PDC180 POLL
# invio = muta il gruppo solo mentre pubblica i sondaggi; chiusura = resta mutato fino alla chiusura
MUTE_MODE=invio
# Solo fuori da Render (su Render si usa RENDER_EXTERNAL_URL in automatico).
# Se vuoto il bot parte in modalità polling.
# PUBLIC_URL=https://mio-bot.example.com
# WEBHOOK_SECRET=una-stringa-a-caso
